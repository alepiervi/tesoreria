# Copia questo file in .env e compila i valori
MONGO_URL=mongodb://localhost:27017
DB_NAME=tesoreria

# Chiave per firmare i token di accesso: usa una stringa lunga e casuale
# (es. il risultato di: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=cambia-questa-chiave
JWT_EXPIRE_HOURS=12

# Indirizzi da cui il frontend può chiamare il backend (separati da virgola)
CORS_ORIGINS=http://localhost:3000

# Indirizzo pubblico del frontend, usato per creare i link di invito
FRONTEND_URL=http://localhost:3000

# true = al primo avvio, se il database è vuoto, carica aziende e utenti di esempio
SEED_DEMO=true

# Provider delle integrazioni: per ora "demo" (dati simulati).
# Quando collegherai i servizi reali, aggiungerai qui i nuovi valori e le relative chiavi.
BANKING_PROVIDER=demo
SDI_PROVIDER=demo
PAYMENTS_PROVIDER=demo

TIMEZONE=Europe/Rome

# ---- Invii email (solleciti, avvisi, riepiloghi) ----
# demo = i messaggi restano nella "casella di prova" del programma, non vengono spediti
EMAIL_PROVIDER=demo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Tesoreria <tesoreria@tuodominio.it>
SMTP_SSL=false

# ---- WhatsApp (avvisi) ----
# demo oppure meta (WhatsApp Business Cloud API: servono token, ID del numero e un modello approvato)
WHATSAPP_PROVIDER=demo
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=avviso_tesoreria

# ---- Attività automatiche ----
SCHEDULER_ENABLED=true
ALERTS_HOUR=8

# ---- Sicurezza ----
# true = per autorizzare un pagamento serve la verifica in due passaggi attiva. Lascialo true con dati veri.
REQUIRE_2FA_FOR_PAYMENTS=true

# ---- Assistente ----
# demo (risposte di base senza servizi esterni) | anthropic (Claude) | none (disattivato)
AI_PROVIDER=demo
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# ---- Backup automatico (una copia al giorno del database) ----
BACKUP_DIR=
BACKUP_KEEP_DAYS=30
